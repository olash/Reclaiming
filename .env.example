# Copy to .env.local for local development, and set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # public "anon" key (safe in the browser)
SUPABASE_SERVICE_ROLE_KEY=              # SERVER ONLY — bypasses row-level security

# Paystack — Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...         # SERVER ONLY. Webhook URL: https://YOUR-DOMAIN/api/webhook/paystack

# QoreID — identity checks
QOREID_CLIENT_ID=
QOREID_CLIENT_SECRET=                   # SERVER ONLY
QOREID_AUTH_URL=https://api.qoreid.com/token

# Mono — BVN account discovery (Lookup / iGree)
MONO_SEC_KEY=                           # SERVER ONLY

# Optional — Google Cloud Vision service-account JSON, base64-encoded.
# Gives reviewers an automatic read of each death certificate. The app works without it.
GCP_SERVICE_ACCOUNT_KEY_BASE64=
